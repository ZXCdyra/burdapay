NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://payflow:payflow@localhost:5432/payflow?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string-min-16-chars
JWT_TTL=12h

APP_ENCRYPTION_KEY=another-long-random-secret-used-for-aes-256-gcm
