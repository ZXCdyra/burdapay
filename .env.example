DEFAULT_ORDER_TTL_SECONDS=900

WEBHOOK_ATTEMPTS=5
WEBHOOK_BACKOFF_BASE_SECONDS=30

AF_WINDOW_SECONDS=600
AF_MAX_PER_IP=10
AF_MAX_PER_DEVICE=15

CORS_ORIGIN=*
THROTTLE_TTL_MILLISECONDS=60000
